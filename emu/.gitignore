# ROM images (Commodore's copyrighted KERNAL/BASIC/character binaries)
# - dump your own from a C64 you own, never commit these. See
# roms/README.md for the expected filenames.
roms/*
!roms/README.md

# Klaus Dormann's 6502 functional test suite (GPL-3.0) - fetched on
# demand via `make fetch` in tests/cpu/, not vendored. See
# tests/cpu/README.md.
tests/cpu/*.bin
tests/cpu/*.lst

# MEGA65's open-roms (GPL-3.0/LGPL-3.0) - fetched on demand via
# `make fetch` in tests/boot/, not vendored. See tests/boot/README.md.
tests/boot/roms/
